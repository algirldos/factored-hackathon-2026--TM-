# NUNCA subas este archivo a GitHub.

# --- MotherDuck (token de lectura y escritura) ---
MOTHERDUCK_TOKEN=PEGA_AQUI_TU_TOKEN_DE_MOTHERDUCK
MOTHERDUCK_DB=latam_bank

# --- Modelo de lenguaje: anthropic | ollama | gemini ---
LLM_PROVIDER=anthropic

# Claude
ANTHROPIC_API_KEY=PEGA_AQUI_TU_API_KEY_DE_ANTHROPIC
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FALLBACK_MODELS=claude-haiku-4-5-20251001

# Ollama (solo si LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_FALLBACK_MODELS=gemma4:e4b

# Gemini (solo si LLM_PROVIDER=gemini)
GEMINI_API_KEY=PEGA_AQUI_TU_API_KEY_DE_GEMINI
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash

# --- Seguridad de las alertas ---
DEMO_MODE=1
CONFIRM_SENDS=1
SHOW_OTP_IN_CONSOLE=1

# --- Canales (1 = activo, 0 = apagado) ---
EMAIL_ENABLED=1
WHATSAPP_ENABLED=0

# --- Destinatarios de la demo ---
TEST_ALERT_EMAIL=PEGA_AQUI_TU_CORREO@gmail.com
TEST_ALERT_WHATSAPP=+57PEGA_AQUI_TU_NUMERO

# --- Correo (Gmail con contraseña de aplicación, sin espacios) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=PEGA_AQUI_TU_CORREO@gmail.com
SMTP_PASSWORD=PEGA_AQUI_TU_CONTRASENA_DE_APLICACION

# --- WhatsApp (Twilio; apagado con WHATSAPP_ENABLED=0) ---
TWILIO_ACCOUNT_SID=PEGA_AQUI_TU_ACCOUNT_SID
TWILIO_AUTH_TOKEN=PEGA_AQUI_TU_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=+17372508034
# TWILIO_CONTENT_SID=HX...
# TWILIO_CONTENT_VARIABLES={"1": "{first_name}", "2": "{email}"}

# --- Flujo OTP ---
OTP_SECRET=PEGA_AQUI_UNA_FRASE_LARGA_Y_NO_LA_CAMBIES
